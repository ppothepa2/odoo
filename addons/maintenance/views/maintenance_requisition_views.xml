<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_maintenance_requisition_form" model="ir.ui.view">
        <field name="name">maintenance.requisition.form</field>
        <field name="model">maintenance.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_request" 
                            string="Submit Request" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="expected_cost"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="requester_name"/>
                            <field name="department"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Detailed description of the equipment..."/>
                        </page>
                        <page string="Additional Notes">
                            <field name="notes" placeholder="Any additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_maintenance_requisition_tree" model="ir.ui.view">
        <field name="name">maintenance.requisition.tree</field>
        <field name="model">maintenance.requisition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="requester_name"/>
                <field name="department"/>
                <field name="request_date"/>
                <field name="priority"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_maintenance_requisition" model="ir.actions.act_window">
        <field name="name">Equipment Requisitions</field>
        <field name="res_model">maintenance.requisition</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_maintenance_requisition"
              name="Equipment Requisitions"
              parent="menu_maintenance_title"
              action="action_maintenance_requisition"
              sequence="5"/>
</odoo>