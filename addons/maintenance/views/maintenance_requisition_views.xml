<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_maintenance_requisition_form" model="ir.ui.view">
        <field name="name">maintenance.requisition.form</field>
        <field name="model">maintenance.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,accounting_review,po_pending,inspection,done,partially_registered_with_equipment,fully_registered_with_equipment"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="requisition_number" placeholder="Draft Requisition"/>
                        </h1>
                    </div>
                    
                    <!-- Section 1: Initial Request -->
                    <div class="o_form_section" name="section_initial_request">
                        <div class="row mb-3">
                            <div class="col-md-7">
                                <h2>
                                    <span>Section 1: Initial Request</span>
                                    <span class="float-right" groups="maintenance.group_maintenance_team">
                                        <button name="action_submit" 
                                                string="Submit" 
                                                type="object"
                                                class="btn btn-primary"
                                                invisible="state != 'draft'"/>
                                    </span>
                                </h2>
                                <group>
                                    <group>
                                        <field name="name" readonly="state != 'draft'"/>
                                        <field name="category_id" 
                                               options="{'no_create': True, 'no_open': True}"
                                               readonly="state != 'draft'"/>
                                        <field name="subcategory_id" 
                                               options="{'no_create': True, 'no_open': True}"
                                               readonly="state != 'draft'"
                                               domain="[('category_id', '=', category_id)]"/>
                                        <field name="quantity" readonly="state != 'draft'"/>
                                        <field name="expected_cost" readonly="state != 'draft'"/>
                                        <field name="priority" readonly="state != 'draft'"/>
                                    </group>
                                    <group>
                                        <field name="requester_name" readonly="state != 'draft'"/>
                                        <field name="department" readonly="state != 'draft'"/>
                                        <field name="request_date"/>
                                        <field name="state" invisible="1"/>
                                    </group>
                                </group>
                            </div>
                            <div class="col-md-5">
                                <h2>Equipment Registration Status</h2>
                                <div class="alert alert-info" role="alert" invisible="state in ('partially_registered_with_equipment', 'fully_registered_with_equipment')">
                                    <p>no equipment registered</p>
                                </div>
                                <field name="equipment_registration_ids" 
                                       invisible="state not in ('partially_registered_with_equipment', 'fully_registered_with_equipment')"
                                       readonly="1">
                                    <tree>
                                        <field name="registration_number"/>
                                        <field name="is_registered"/>
                                        <button name="action_open_equipment" 
                                                type="object" 
                                                string="Open" 
                                                class="btn btn-primary btn-sm"/>
                                    </tree>
                                </field>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Description">
                            <field name="description" readonly="state != 'draft'"/>
                        </page>
                        <page string="Product Information">
                            <group>
                                <group>
                                    <field name="vendor" readonly="state != 'draft'"/>
                                    <field name="vendor_reference" readonly="state != 'draft'"/>
                                    <field name="model" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="cost" readonly="state != 'draft'"/>
                                    <field name="warranty_expiration_date" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Additional Notes">
                            <field name="notes" readonly="state != 'draft'"/>
                        </page>
                    </notebook>

                    <!-- Section 2: Accounting Review -->
                    <div class="o_form_section" name="section_accounting_review" 
                         invisible="state == 'draft'">
                        <h2>
                            <span>Section 2: Accounting Review</span>
                            <span class="float-right" groups="maintenance.group_accounting_team">
                                <button name="action_approve" 
                                        string="Approve" 
                                        type="object"
                                        class="btn btn-success"
                                        invisible="state != 'submitted'"/>
                                <button name="action_reject" 
                                        string="Reject" 
                                        type="object"
                                        class="btn btn-danger"
                                        invisible="state != 'submitted'"/>
                            </span>
                        </h2>
                        <group>
                            <field name="rejection_reason" 
                                   readonly="state != 'submitted'"
                                   groups="maintenance.group_accounting_team"/>
                        </group>
                    </div>

                    <!-- Section 3: PO Upload -->
                    <div class="o_form_section" name="section_po_upload" 
                         invisible="state not in ('po_pending', 'inspection', 'done', 'partially_registered_with_equipment', 'fully_registered_with_equipment')">
                        <h2>
                            <span>Section 3: PO Details</span>
                            <span class="float-right" groups="maintenance.group_accounting_team">
                                <button name="action_upload_po" 
                                        string="Submit PO" 
                                        type="object"
                                        class="btn btn-primary"
                                        invisible="state != 'po_pending'"/>
                            </span>
                        </h2>
                        <group>
                            <field name="po_number" 
                                   readonly="state != 'po_pending'"
                                   groups="maintenance.group_accounting_team"/>
                            <field name="purchase_cost"
                                   readonly="state != 'po_pending'"
                                   groups="maintenance.group_accounting_team"/>
                            <field name="po_attachment" 
                                   readonly="state != 'po_pending'"
                                   filename="po_attachment_name"
                                   groups="maintenance.group_accounting_team"/>
                            <field name="po_attachment_name" invisible="1"/>
                        </group>
                    </div>

                    <!-- Section 4: Inspection -->
                    <div class="o_form_section" name="section_inspection" 
                         invisible="state not in ('inspection', 'done', 'partially_registered_with_equipment', 'fully_registered_with_equipment')">
                        <h2>
                            <span>Section 4: Equipment Inspection</span>
                            <span class="float-right" groups="maintenance.group_maintenance_team">
                                <button name="action_complete_inspection" 
                                        string="Complete Inspection" 
                                        type="object"
                                        class="btn btn-primary"
                                        invisible="state != 'inspection'"/>
                            </span>
                        </h2>
                        <group>
                            <field name="inspection_notes" 
                                   readonly="state != 'inspection'"
                                   groups="maintenance.group_maintenance_team"/>
                        </group>
                    </div>

                    <!-- Log Details Section -->
                    <div class="o_form_section" name="section_log_details">
                        <h2>Log Details</h2>
                        <group>
                            <group>
                                <field name="submitted_by" readonly="1"/>
                                <field name="submitted_date" readonly="1"/>
                                <field name="reviewed_by" readonly="1"/>
                                <field name="reviewed_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="po_uploaded_by" readonly="1"/>
                                <field name="po_uploaded_date" readonly="1"/>
                                <field name="inspected_by" readonly="1"/>
                                <field name="inspected_date" readonly="1"/>
                            </group>
                        </group>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_maintenance_requisition_tree" model="ir.ui.view">
        <field name="name">maintenance.requisition.tree</field>
        <field name="model">maintenance.requisition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="requisition_number"/>
                <field name="name"/>
                <field name="requester_name"/>
                <field name="department"/>
                <field name="request_date"/>
                <field name="priority"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_maintenance_requisition_kanban" model="ir.ui.view">
        <field name="name">maintenance.requisition.kanban</field>
        <field name="model">maintenance.requisition</field>
        <field name="arch" type="xml">
            <kanban default_order="is_summary desc, card_color_order desc, requisition_number desc" class="o_kanban_dashboard">
                <field name="is_summary"/>
                <field name="name"/>
                <field name="requisition_number"/>
                <field name="state"/>
                <field name="days_remaining"/>
                <field name="card_color"/>
                <field name="stats_count"/>
                <field name="stats_cost"/>
                <field name="stats_purchase_cost"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="col-4 p-1">
                            <t t-if="record.is_summary.raw_value">
                                <div class="oe_kanban_card rounded" style="height: 90px; background-color: #2b2b2b;">
                                    <div class="p-2">
                                        <div class="text-white small mb-1 font-weight-bold">
                                            <t t-esc="record.name.raw_value"/>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <div class="text-white small">
                                                    Requisitions: <field name="stats_count"/>
                                                </div>
                                            </div>
                                            <div class="col-6 text-right">
                                                <div class="text-white small">
                                                    Est: $<field name="stats_cost"/>
                                                </div>
                                                <div class="text-white small">
                                                    Act: $<field name="stats_purchase_cost"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="oe_kanban_global_click oe_kanban_card rounded" 
                                     t-attf-style="height: 90px; background-color: #{
                                        record.state.raw_value == 'submitted' ? '#dc3545' :
                                        record.state.raw_value == 'po_pending' ? '#ffc107' :
                                        record.state.raw_value == 'inspection' ? '#ffc107' :
                                        record.state.raw_value == 'done' ? '#28a745' : 'white'};">
                                    <div class="p-2">
                                        <div class="d-flex justify-content-between mb-1">
                                            <div class="small font-weight-bold text-black">
                                                <field name="requisition_number"/>
                                            </div>
                                            <t t-if="record.state.raw_value == 'submitted'">
                                                <div class="small text-black">
                                                    <t t-if="record.days_remaining.raw_value > 0">
                                                        Due in <field name="days_remaining"/> days
                                                    </t>
                                                    <t t-else="">
                                                        Overdue
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                        <div class="small mb-1 text-black text-truncate">
                                            <field name="name"/>
                                        </div>
                                        <div class="small text-black">
                                            Status: <field name="state"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_maintenance_requisition_search" model="ir.ui.view">
        <field name="name">maintenance.requisition.search</field>
        <field name="model">maintenance.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="requisition_number"/>
                <field name="name"/>
                <field name="requester_name"/>
                <field name="department"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('state','=','accounting_review')]"/>
                <filter string="PO Pending" name="po_pending" domain="[('state','=','po_pending')]"/>
                <filter string="Inspection" name="inspection" domain="[('state','=','inspection')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <filter string="Registered with Equipment" name="registered_with_equipment" domain="[('state','=','registered_with_equipment')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by':'department'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by':'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_maintenance_requisition" model="ir.actions.act_window">
        <field name="name">Equipment Requisitions</field>
        <field name="res_model">maintenance.requisition</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_maintenance_requisition_search"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_maintenance_requisition"
              name="Equipment Requisitions"
              parent="menu_maintenance_title"
              action="action_maintenance_requisition"
              sequence="5"/>
</odoo>