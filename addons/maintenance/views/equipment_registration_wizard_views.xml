<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_registration_wizard_form" model="ir.ui.view">
        <field name="name">equipment.registration.wizard.form</field>
        <field name="model">equipment.registration.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Equipment">
                <sheet>
                    <group>
                        <field name="equipment_id" invisible="1"/>
                        <field name="proposed_identifier" readonly="1"/>
                        <p>Do you want to register this equipment with the proposed identifier?</p>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_registration_wizard" model="ir.actions.act_window">
        <field name="name">Register Equipment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">equipment.registration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo> 